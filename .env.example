# Copy to .env and replace every value before starting Docker Compose.
# Generate URL-safe secrets with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=GENERATE_A_RANDOM_VALUE
MYSQL_USER=fluxfeed
MYSQL_PASSWORD=GENERATE_A_RANDOM_VALUE
REDIS_PASSWORD=GENERATE_A_RANDOM_VALUE
RABBITMQ_USER=fluxfeed
RABBITMQ_PASSWORD=GENERATE_A_RANDOM_VALUE
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN=fluxfeed-admin
ADMIN_PW=GENERATE_A_RANDOM_ADMIN_PASSWORD
GRAFANA_ADMIN_USER=fluxfeed-admin
GRAFANA_ADMIN_PASSWORD=GENERATE_A_RANDOM_VALUE

# Optional account recovery and OAuth. All three groups can be enabled together.
# Keep an unused group empty; partially configured groups are rejected at startup.
# Public browser-facing URL. Production must use HTTPS.
FLUXFEED_PUBLIC_URL=http://localhost:5173

# SMTP: enables email verification and password reset.
# Gmail example: host=smtp.gmail.com, port=587, tls_mode=starttls.
# Use the mailbox address as username/from and a 16-digit Google App Password.
FLUXFEED_SMTP_HOST=
FLUXFEED_SMTP_PORT=587
FLUXFEED_SMTP_USERNAME=
FLUXFEED_SMTP_PASSWORD=
FLUXFEED_SMTP_FROM=
FLUXFEED_SMTP_TLS_MODE=starttls

# Google OAuth web client.
# Local callback: http://localhost:5173/api/oauth/google/callback
FLUXFEED_GOOGLE_CLIENT_ID=
FLUXFEED_GOOGLE_CLIENT_SECRET=

# GitHub OAuth App.
# Local callback: http://localhost:5173/api/oauth/github/callback
FLUXFEED_GITHUB_CLIENT_ID=
FLUXFEED_GITHUB_CLIENT_SECRET=
